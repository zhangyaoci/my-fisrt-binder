import os

from fastai.vision.all import *
from pathlib import Path

# 1. 确保已设置好 key（参考前面小节获取到的 key）
key = "0661d1d5050c944ee891e420939c53922ac34d63c4b266e30a7bdbcf2ee46381"

# 2. 调用 search_images_serpapi 搜索熊的照片
# max_images=50 指定获取 50 个图片的链接
results = search_images_serpapi('Teddy bear', key=key, max_images=50)
ims = results

print(f"成功获取到 {len(ims)} 个图片链接")

# 3. 创建保存照片的文件夹
path = Path('bears')
dest = path / 'Teddy'
dest.mkdir(exist_ok=True, parents=True)

# 4. 使用 fastai 的 download_images 批量下载这 50 张照片
download_images(dest, urls=ims)

print("下载完成！照片已保存在:", dest)
